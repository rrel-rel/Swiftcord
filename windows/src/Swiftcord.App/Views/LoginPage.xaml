<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Swiftcord.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Swiftcord.App.Helpers">

    <Grid Padding="12,0,12,12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- The real discord.com login page, so captchas, 2FA and passkeys all just work. -->
        <Border
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <WebView2 x:Name="LoginWebView" />
                <ProgressRing
                    x:Name="WebViewLoading"
                    Width="40"
                    Height="40"
                    IsActive="True" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="12,24,12,12" Spacing="16">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Welcome to Swiftcord" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Sign in to Discord on the left. Swiftcord keeps your token in Windows Credential Manager and only ever sends it to Discord."
                    TextWrapping="Wrap" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind h:Ui.HasText(ViewModel.Error), Mode=OneWay}"
                    Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                    Severity="Error" />

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Sign in with a token instead">
                    <StackPanel Spacing="12">
                        <PasswordBox
                            Header="Token"
                            Password="{x:Bind ViewModel.ManualToken, Mode=TwoWay}"
                            PlaceholderText="Paste your token" />
                        <ToggleSwitch
                            Header="Bot account"
                            IsOn="{x:Bind ViewModel.IsBotToken, Mode=TwoWay}"
                            OffContent="User token"
                            OnContent="Bot token" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.SubmitManualTokenCommand}"
                            Content="Sign in"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Expander>

                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Swiftcord is an unofficial client and isn't affiliated with Discord. Third-party clients are against Discord's Terms of Service; use at your own risk."
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
