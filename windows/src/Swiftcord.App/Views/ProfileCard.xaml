<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Swiftcord.App.Views.ProfileCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Swiftcord.App.Controls"
    xmlns:h="using:Swiftcord.App.Helpers"
    xmlns:p="using:Swiftcord.ViewModels.Profiles"
    Width="320">

    <UserControl.Resources>
        <Style x:Key="ProfileHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <DataTemplate x:Key="RoleChipTemplate" x:DataType="p:RoleChip">
            <Border
                Padding="6,2"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="4">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Ellipse
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center"
                        Fill="{x:Bind h:Ui.RoleBrush(Color)}" />
                    <TextBlock FontSize="12" Text="{x:Bind Name}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Banner: an image, or the profile colour -->
        <Border Background="{x:Bind h:Ui.BannerBrush(ViewModel.BannerColor), Mode=OneWay}" CornerRadius="8,8,0,0">
            <Image Stretch="UniformToFill" Visibility="{x:Bind ViewModel.HasBanner, Mode=OneWay}">
                <Image.Source>
                    <BitmapImage UriSource="{x:Bind ViewModel.BannerUri, Mode=OneWay}" />
                </Image.Source>
            </Image>
        </Border>

        <!-- Avatar overlapping the banner, with presence -->
        <Grid
            Grid.Row="1"
            Width="88"
            Height="88"
            Margin="16,-48,0,0"
            HorizontalAlignment="Left">
            <Ellipse Fill="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}" />
            <Ellipse Width="80" Height="80">
                <Ellipse.Fill>
                    <ImageBrush Stretch="UniformToFill">
                        <ImageBrush.ImageSource>
                            <BitmapImage DecodePixelWidth="160" UriSource="{x:Bind ViewModel.AvatarUri}" />
                        </ImageBrush.ImageSource>
                    </ImageBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse
                Width="22"
                Height="22"
                Margin="0,0,4,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Fill="{x:Bind h:Ui.PresenceBrush(ViewModel.Status)}"
                Stroke="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
                StrokeThickness="4"
                Visibility="{x:Bind h:Ui.PresenceVisibility(ViewModel.Status)}" />
        </Grid>

        <StackPanel
            Grid.Row="2"
            Padding="16,8,16,16"
            Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.DisplayName}"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.Username}" />
                    <Border
                        Padding="4,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="3"
                        Visibility="{x:Bind ViewModel.IsBot}">
                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Text="BOT" />
                    </Border>
                </StackPanel>
                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.Pronouns, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasPronouns, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Visibility="{x:Bind ViewModel.HasBio, Mode=OneWay}">
                <TextBlock Style="{StaticResource ProfileHeaderStyle}" Text="About me" />
                <c:MarkdownTextBlock MessageContext="{x:Bind ViewModel.Context}" Nodes="{x:Bind ViewModel.Bio, Mode=OneWay}" />
            </StackPanel>

            <StackPanel>
                <TextBlock Style="{StaticResource ProfileHeaderStyle}" Text="Member since" />
                <TextBlock>
                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Discord:" />
                    <Run Text="{x:Bind ViewModel.AccountCreated}" />
                </TextBlock>
                <TextBlock Visibility="{x:Bind ViewModel.HasServerJoined, Mode=OneWay}">
                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="This server:" />
                    <Run Text="{x:Bind ViewModel.ServerJoined, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <StackPanel Visibility="{x:Bind ViewModel.HasRoles, Mode=OneWay}">
                <TextBlock Style="{StaticResource ProfileHeaderStyle}" Text="Roles" />
                <ItemsControl ItemTemplate="{StaticResource RoleChipTemplate}" ItemsSource="{x:Bind ViewModel.Roles, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <TextBlock
                Style="{StaticResource SecondaryTextStyle}"
                Text="{x:Bind ViewModel.MutualServers, Mode=OneWay}"
                Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.MutualServers), Mode=OneWay}" />

            <Button
                HorizontalAlignment="Stretch"
                Click="OnMessageClick"
                Content="Message"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.CanMessage}" />
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.Error), Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
