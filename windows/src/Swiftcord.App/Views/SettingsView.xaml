<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Swiftcord.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Swiftcord.App.Helpers">

    <UserControl.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" KeyDown="OnKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Padding="24,16"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                x:Name="CloseButton"
                AutomationProperties.Name="Close settings"
                Command="{x:Bind Shell.CloseSettingsCommand, Mode=OneWay}"
                Content="&#xE72B;"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Close (Esc)" />
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Settings" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="24,0,24,24">
            <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">

                <!-- Account -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" Text="My account" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="48" Height="48">
                            <Ellipse.Fill>
                                <ImageBrush Stretch="UniformToFill">
                                    <ImageBrush.ImageSource>
                                        <BitmapImage DecodePixelWidth="96" UriSource="{x:Bind Shell.CurrentUserAvatar, Mode=OneWay}" />
                                    </ImageBrush.ImageSource>
                                </ImageBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Shell.CurrentUserName, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Shell.CurrentUserTag, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Command="{x:Bind Shell.LogoutCommand, Mode=OneWay}"
                            Content="Log out" />
                    </Grid>
                </Border>

                <!-- Appearance -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Appearance" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Theme" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Use the Windows setting, or always light or dark." />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="160"
                            VerticalAlignment="Center"
                            SelectedIndex="{x:Bind Shell.Settings.ThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Use system setting" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Notifications -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Notifications" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Desktop notifications" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Which messages notify follows your Discord notification settings for each server and channel."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                MinWidth="0"
                                IsOn="{x:Bind Shell.Settings.NotificationsEnabled, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Show message text" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Off shows only who messaged you and where." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                MinWidth="0"
                                IsEnabled="{x:Bind Shell.Settings.CanChangePreviews, Mode=OneWay}"
                                IsOn="{x:Bind Shell.Settings.NotificationPreviews, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Updates" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock>
                                    <Run Text="Swiftcord" />
                                    <Run Text="{x:Bind Shell.Settings.Version, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind Shell.Settings.UpdateStatus, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    Command="{x:Bind Shell.Settings.RestartToUpdateCommand, Mode=OneWay}"
                                    Content="Restart to update"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind Shell.Settings.IsUpdateReady, Mode=OneWay}" />
                                <Button Command="{x:Bind Shell.Settings.CheckForUpdatesCommand, Mode=OneWay}" Content="Check for updates" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar
                            IsIndeterminate="False"
                            Maximum="100"
                            Visibility="{x:Bind Shell.Settings.IsCheckingForUpdates, Mode=OneWay}"
                            Value="{x:Bind Shell.Settings.UpdateProgress, Mode=OneWay}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Update automatically" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Download new versions in the background when Swiftcord starts." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                MinWidth="0"
                                IsEnabled="{x:Bind Shell.Settings.CanUpdate, Mode=OneWay}"
                                IsOn="{x:Bind Shell.Settings.AutomaticUpdates, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Advanced -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Troubleshooting" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Logs" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Include swiftcord.log when reporting a problem." />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnOpenLogsClick"
                            Content="Open logs folder" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
