<Solution>
  <Configurations>
    <Platform Name="x64" />
    <Platform Name="ARM64" />
  </Configurations>
  <Folder Name="/src/">
    <!-- WinUI app: Windows only. Use Swiftcord.CrossPlatform.slnf on macOS/Linux. -->
    <Project Path="src/Swiftcord.App/Swiftcord.App.csproj" />
    <Project Path="src/Swiftcord.Core/Swiftcord.Core.csproj">
      <Platform Project="Any CPU" />
    </Project>
    <Project Path="src/Swiftcord.ViewModels/Swiftcord.ViewModels.csproj">
      <Platform Project="Any CPU" />
    </Project>
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Swiftcord.Core.Tests/Swiftcord.Core.Tests.csproj">
      <Platform Project="Any CPU" />
    </Project>
    <Project Path="tests/Swiftcord.ViewModels.Tests/Swiftcord.ViewModels.Tests.csproj">
      <Platform Project="Any CPU" />
    </Project>
  </Folder>
</Solution>
